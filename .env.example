# Root .env: read by `docker compose` for variable substitution only
# (passwords and edge settings). App settings live in backend/.env.
POSTGRES_PASSWORD=changeme
AGENT_DB_PASSWORD=changeme-agent
# Must match MCP_INTERNAL_TOKEN in backend/.env (the code sandbox gets it from here).
MCP_INTERNAL_TOKEN=

# --- edge / tunnel profiles ---------------------------------------------------
# A domain pointing at this machine (automatic HTTPS), or :80 behind a tunnel.
SITE_ADDRESS=:80
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Where the frontend repo is checked out (built into the `web` image).
FRONTEND_DIR=../agenticapp-frontend
# Cloudflare named tunnel token (profile `tunnel`).
CLOUDFLARE_TUNNEL_TOKEN=
