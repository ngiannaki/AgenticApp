# Universal Ollama settings (backend/core/config.py)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Agentic API settings (backend/apps/api/config.py)
# MongoDB backs durable conversation/message storage for the chat UI.
# Matches the container started by start_mcp_servers.ps1 (agenticapp-mongo).
API_MONGO_URL=mongodb://localhost:27017
API_MONGO_DB_NAME=agentic_chat
