# =============================================================================
# Copy to backend/.env and fill in real values.
#
# Single source of truth for backend configuration (see backend/config/).
# ENVIRONMENT selects which model/client each LLM-calling functionality below
# uses: DEV -> local Ollama, PROD -> real OpenAI. Every functionality still
# goes through the same AsyncOpenAI-compatible client either way.
# =============================================================================

ENVIRONMENT=DEV

# --- Ollama (used when ENVIRONMENT=DEV) -------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Context window (tokens) requested for every DEV chat call. Ollama's own default
# is only 2048 tokens no matter what the model supports, which is why chats
# "forget" earlier turns fast. Native max per model currently used in DEV:
#   gpt-oss:20b -> 131072 (128k). Going above a model's native max has no effect
# beyond that max (Ollama clamps down to it) but does cost more VRAM/RAM.
OLLAMA_NUM_CTX=8192
# Reasoning effort requested from thinking-capable models (e.g. gpt-oss:20b):
# low | medium | high, or blank to leave thinking at the model's own default.
# Ollama returns the model's chain-of-thought in the response's "reasoning"
# field, which the API streams to the frontend as an SSE "reasoning" event.
OLLAMA_REASONING_EFFORT=medium

# --- OpenAI (used when ENVIRONMENT=PROD) ------------------------------------
OPENAI_API_KEY=
# Leave blank for api.openai.com; set to point at Azure OpenAI or another
# OpenAI-compatible endpoint instead.
OPENAI_BASE_URL=
# Reasoning effort for a reasoning-capable PROD model: low | medium | high | none.
# Leave blank for a classic (non-reasoning) model like gpt-4o-mini — OpenAI
# rejects this parameter outright for those. Required (at minimum "none") for
# a reasoning model, since OpenAI separately rejects tool calls for a
# reasoning model with no reasoning_effort at all. Paired with the _PROD
# model vars below — set/clear both together when switching models.
OPENAI_REASONING_EFFORT=

# --- Per-functionality models -------------------------------------------------
# Chat agent (backend/apps/api)
CHAT_MODEL_DEV=gpt-oss:20b
CHAT_MODEL_PROD=gpt-4o-mini

# Embeddings — shared by indexing and retrieval; both must use the same model
# so vectors written at index time line up with vectors used at query time.
EMBEDDING_MODEL_DEV=qwen3-embedding:4b
EMBEDDING_MODEL_PROD=text-embedding-3-small

# Retrieval MCP server's answer-synthesis LLM (backend/mcp_servers/retrieval)
RETRIEVAL_MODEL_DEV=gpt-oss:20b
RETRIEVAL_MODEL_PROD=gpt-4o-mini
RETRIEVAL_MODEL_TEMPERATURE=0.7

# Document metadata enhancement LLM — summaries/sections (backend/infrastructure/vector_store)
METADATA_MODEL_DEV=gpt-oss:20b
METADATA_MODEL_PROD=gpt-4o-mini
METADATA_MODEL_TEMPERATURE=0.1

# --- Agentic API (backend/apps/api) ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8100
API_TEMPERATURE=0.3
API_MAX_ITERATIONS=15
API_MAX_HISTORY_MESSAGES=40
# Hard cap on a single tool result's length before it enters conversation
# memory. Backstop for tools/models that inline large payloads (e.g. base64
# image data) instead of returning a URL as instructed. Needs to comfortably
# exceed legitimate large results (e.g. a big document's table of contents)
# or the model silently loses the tail of the data it asked for.
API_MAX_TOOL_RESULT_CHARS=32000
API_LOG_LEVEL=INFO
# Stream replies token by token (false = whole reply at once).
API_STREAM_TOKENS=true
# Per-user daily limits (0 = unlimited). Over the limit the API returns 429.
API_DAILY_CHAT_TURNS=0
API_DAILY_UPLOADS=0
API_DAILY_AGENT_TASKS=0
# Usage / cost tracking (the Usage page). Metadata only: no prompts or answers are stored.
OBS_ENABLED=true
# Rows older than this are deleted at API startup (0 = keep forever).
OBS_RETENTION_DAYS=90
# Ask the model server for token counts on streamed replies; set false if it rejects
# stream_options (tokens are then estimated and marked with ~).
OBS_STREAM_USAGE=true
# Comma-separated emails that can see everyone's usage (the "Everyone" view).
OBS_ADMIN_EMAILS=
# Price overrides in USD per 1M tokens, by model-name prefix. Check your provider's
# pricing: the built-in defaults (backend/config/pricing.py) can be out of date.
# OBS_PRICING_JSON={"gpt-4o-mini": {"input": 0.15, "cached_input": 0.075, "output": 0.6}}
# Tools the chat model may see/call (JSON list of "<server>_<tool>" names).
# Leave unset for the safe default allowlist in backend/config/settings.py
# (no indexing_* tools, no raw chunk dumps). ["*"] exposes everything —
# single-user local debugging only.
# API_MODEL_TOOLS=["retrieval_retrieve_document_v2","retrieval_web_search"]
# Tools that ALWAYS pause for human approval; a session can add to this but
# never remove from it. Default: the DB insert/update/delete/create/alter tools.
# API_MANDATORY_APPROVAL_TOOLS=["db_create_table","db_update_table_definition","db_insert_data","db_update_data","db_delete_data"]
# Ceiling on a single model-initiated tool call before it's reported back as a timeout.
API_TOOL_CALL_TIMEOUT_SECONDS=300
# Off by default (purely additive). When true, the chat agent gets two extra
# local tools (list_skills / get_skill) that let it discover and read
# markdown skill files from backend/skills/ on demand (Agent Skills format,
# agentskills.io) instead of relying only on its built-in knowledge.
API_SKILLS_ENABLED=false

# --- MCP servers: internal token ---------------------------------------------
# Every MCP server trusts the user_id the API sends, so only the API may call
# them: with this set, each requires `Authorization: Bearer <token>` and the
# API sends it automatically. Use a long random string (python -c "import
# secrets; print(secrets.token_urlsafe(32))"); with docker compose, put the same
# value in the root .env too (for the code sandbox). Blank = open (warning).
MCP_INTERNAL_TOKEN=

# --- Retrieval MCP server networking -----------------------------------------
RETRIEVAL_MCP_HOST=127.0.0.1
RETRIEVAL_MCP_PORT=8001
RERANK_RETRIEVAL_THRESHOLD=0.1

# --- Indexing MCP server networking ------------------------------------------
INDEXING_MCP_HOST=127.0.0.1
INDEXING_MCP_PORT=8000

# --- Postgres: the one database (backend/core/db) ----------------------------
# Users, conversations, the document registry, document chunks + embeddings
# (pgvector), and each user's private DB-tool tables all live here. Matches
# the container started by start_mcp_servers.ps1 / docker compose
# (pgvector/pgvector:pg16). Migrations are applied automatically.
DATABASE_URL=postgresql://raguser:changeme@localhost:5432/ragdb
# The DB MCP server connects as this separate, restricted role (no access to
# the app's own data, only to per-user ws_* schemas). The API creates it at
# startup with this password — keep it in sync with DB_MCP_DATABASE_URL below.
DATABASE_AGENT_ROLE=agent_ws
DATABASE_AGENT_ROLE_PASSWORD=changeme-agent

# --- Database MCP server (backend/mcp_servers/db) ----------------------------
DB_MCP_DATABASE_URL=postgresql://agent_ws:changeme-agent@localhost:5432/ragdb
DB_MCP_POOL_MIN_SIZE=2
DB_MCP_POOL_MAX_SIZE=25
DB_MCP_HOST=127.0.0.1
DB_MCP_PORT=8002
DB_MCP_MAX_QUERY_ROWS=1000
DB_MCP_MAX_QUERY_LENGTH=10000
DB_MCP_QUERY_TIMEOUT_SECONDS=10
DB_MCP_MAX_RESULT_BYTES=5000000
DB_MCP_MAX_TABLES_PER_QUERY=10
DB_MCP_MAX_JOINS_PER_QUERY=8
DB_MCP_MAX_CTE_COUNT=5
DB_MCP_MAX_SUBQUERY_DEPTH=4
DB_MCP_ALLOW_SCHEMA_CHANGES=true
DB_MCP_ALLOW_DELETE=true
DB_MCP_ALLOW_FULL_TABLE_DELETE=false
DB_MCP_ALLOW_DESTRUCTIVE_SCHEMA_OPS=false
DB_MCP_MUTATION_TIMEOUT_SECONDS=30
DB_MCP_MAX_BATCH_INSERT_RECORDS=1000
DB_MCP_PERMISSIONS_FILE=backend/mcp_servers/db/permissions.yaml
DB_MCP_LOG_DIR=logs
DB_MCP_LOG_LEVEL=INFO

# --- Code Execution MCP server (backend/mcp_servers/code) --------------------
CODE_MCP_HOST=127.0.0.1
CODE_MCP_PORT=8003
# Leave blank to use the interpreter running the server (the project's venv).
CODE_MCP_PYTHON_EXECUTABLE=
CODE_MCP_DEFAULT_TIMEOUT_SECONDS=10
CODE_MCP_MAX_TIMEOUT_SECONDS=60
CODE_MCP_MAX_CODE_LENGTH=50000
CODE_MCP_MAX_OUTPUT_BYTES=200000
CODE_MCP_WORKSPACE_DIR=backend/data/code_sandbox
# OS isolation for submitted code: each run as its own unprivileged uid with
# resource limits. Needs the server to run as root on Linux — the
# code-sandbox container sets CODE_MCP_ISOLATION=uid and
# CODE_MCP_REQUIRE_ISOLATION=true itself. "auto" falls back to running
# unisolated (with a warning) anywhere else, e.g. natively on Windows.
CODE_MCP_ISOLATION=auto
CODE_MCP_MAX_MEMORY_MB=2048
CODE_MCP_MAX_PROCESSES=64
CODE_MCP_KEEP_WORKSPACE=false
# Files run_python_code leaves behind (e.g. a plot saved with plt.savefig)
# are captured and served back to the UI at .../api/files/{id}/{filename}.
CODE_MCP_CAPTURE_ARTIFACTS=true
CODE_MCP_MAX_ARTIFACT_BYTES=10000000
CODE_MCP_MAX_ARTIFACTS_PER_RUN=5
# Where the Agentic API is actually reachable from a browser — used to build
# the URL handed back for a captured artifact. Point this through nginx
# (e.g. https://localhost:8443) in a non-default deployment.
CODE_MCP_ARTIFACT_PUBLIC_BASE_URL=http://localhost:8100
# Off by default: run_shell_command is disabled until explicitly turned on.
CODE_MCP_ALLOW_SHELL_COMMANDS=false
# On by default: the generate_ui tool lets the model author a custom
# HTML/CSS/JS component that the frontend renders inline in a sandboxed
# iframe. Set to false to remove the tool from the model's tool list
# entirely (instant kill switch, no frontend change needed) if it's being
# used more than you'd like.
CODE_MCP_ALLOW_UI_GENERATION=true
CODE_MCP_MAX_UI_HTML_LENGTH=200000
CODE_MCP_LOG_DIR=logs
CODE_MCP_LOG_LEVEL=INFO

# --- Storage paths -------------------------------------------------------------
# Uploaded originals (re-indexable with `python -m backend.scripts.reindex_all`)
# and generated artifacts. Vectors live in Postgres, not on disk.
DOCUMENT_STORE_DIR=data/documents
ARTIFACT_STORE_DIR=data/artifacts

# --- Google Document AI parser (backend/mcp_servers/indexing/parsers) --------
GOOGLE_DOCAI_USE_PARSER=false
GOOGLE_DOCAI_PROJECT_ID=project-db0446e6-5527-4b1b-ba4
GOOGLE_DOCAI_LOCATION=eu
GOOGLE_DOCAI_PROCESSOR_ID=45e6c24dbbd65e16
GOOGLE_DOCAI_CREDENTIALS_PATH=

# --- Auth (backend/apps/api/auth.py) -----------------------------------------
# Local-dev-only escape hatch, independent of ENVIRONMENT. When true, every
# request is treated as one seeded test account and the frontend skips the
# sign-in screen entirely. NEVER enable this in a deployment reachable by
# more than one person.
AUTH_DEV_BYPASS=true
# Sign-up: set an invite code before sharing a deployment (blank = open sign-up),
# or turn sign-up off and use `python -m backend.scripts.create_user <email>`.
AUTH_SIGNUP_ENABLED=true
AUTH_INVITE_CODE=
# Sign-ins last this long and renew while used; failed sign-ins per IP/email per 15 min.
AUTH_TOKEN_TTL_DAYS=30
AUTH_LOGIN_MAX_FAILURES=10
AUTH_DEV_BYPASS_EMAIL=dev@local.test
AUTH_DEV_BYPASS_PASSWORD=dev-password

# --- A2A agents (backend/apps/agents: Deep Research, Data Analyst, ...) -------
# The agents service runs every registered agent; the API drives it over A2A
# and the agents call tools back through the API. Both processes must share
# this secret — agents stay disabled until it is set. Use a long random value.
AGENTS_INTERNAL_TOKEN=change-me-to-a-long-random-string
# Where the API reaches the agents service, and the agents reach the API.
AGENTS_URL=http://localhost:9100
AGENTS_API_URL=http://localhost:8100
AGENTS_MAX_ACTIVE_TASKS_PER_USER=2
