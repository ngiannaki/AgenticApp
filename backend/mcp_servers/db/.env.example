# Copy to backend/mcp_servers/db/.env and fill in real values.
# Every setting is also overridable as a plain environment variable with the
# DB_MCP_ prefix shown below (Settings in config/settings.py).

# --- Connectivity ------------------------------------------------------------
DB_MCP_DATABASE_URL=postgresql://raguser:changeme@localhost:5432/ragdb
DB_MCP_POOL_MIN_SIZE=1
DB_MCP_POOL_MAX_SIZE=10

# --- Server --------------------------------------------------------------------
DB_MCP_HOST=0.0.0.0
DB_MCP_PORT=8002

# --- query_data safety limits --------------------------------------------------
DB_MCP_MAX_QUERY_ROWS=1000
DB_MCP_MAX_QUERY_LENGTH=10000
DB_MCP_QUERY_TIMEOUT_SECONDS=10
DB_MCP_MAX_RESULT_BYTES=5000000
DB_MCP_MAX_TABLES_PER_QUERY=10
DB_MCP_MAX_JOINS_PER_QUERY=8
DB_MCP_MAX_CTE_COUNT=5
DB_MCP_MAX_SUBQUERY_DEPTH=4

# --- Mutation / schema safety switches ------------------------------------------
DB_MCP_ALLOW_SCHEMA_CHANGES=true
DB_MCP_ALLOW_DELETE=true
DB_MCP_ALLOW_FULL_TABLE_DELETE=false
DB_MCP_ALLOW_DESTRUCTIVE_SCHEMA_OPS=false
DB_MCP_MUTATION_TIMEOUT_SECONDS=30
DB_MCP_MAX_BATCH_INSERT_RECORDS=1000

# --- Authorization -----------------------------------------------------------
# Path to the permissions config (see permissions.example.yaml). Copy it to
# permissions.yaml alongside this .env file and point this at it, or use an
# absolute path.
DB_MCP_PERMISSIONS_FILE=backend/mcp_servers/db/permissions.yaml

# --- Logging -------------------------------------------------------------------
DB_MCP_LOG_DIR=logs
DB_MCP_LOG_LEVEL=INFO
