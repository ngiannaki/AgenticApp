# DEPRECATED: this file is no longer read. CODE_MCP_* settings live in the
# single backend/.env (see backend/config/settings.py, CodeMcpSettings)
# alongside every other backend setting. Kept here only as a reference for
# the CODE_MCP_* variable list; edit backend/.env.example instead.

# --- Server --------------------------------------------------------------------
CODE_MCP_HOST=0.0.0.0
CODE_MCP_PORT=8003

# --- Execution -------------------------------------------------------------------
# Leave blank to use the interpreter running the server (the project's venv).
CODE_MCP_PYTHON_EXECUTABLE=
CODE_MCP_DEFAULT_TIMEOUT_SECONDS=10
CODE_MCP_MAX_TIMEOUT_SECONDS=60
CODE_MCP_MAX_CODE_LENGTH=50000
CODE_MCP_MAX_OUTPUT_BYTES=200000
CODE_MCP_WORKSPACE_DIR=backend/data/code_sandbox
CODE_MCP_KEEP_WORKSPACE=false

# --- Generated-file capture (plots, CSVs, ...) -------------------------------------
CODE_MCP_CAPTURE_ARTIFACTS=true
CODE_MCP_MAX_ARTIFACT_BYTES=10000000
CODE_MCP_MAX_ARTIFACTS_PER_RUN=5
CODE_MCP_ARTIFACT_PUBLIC_BASE_URL=http://localhost:8100

# --- Shell command tool (off by default) ------------------------------------------
CODE_MCP_ALLOW_SHELL_COMMANDS=false
CODE_MCP_ALLOWED_SHELL_EXECUTABLES=["python","pip","pytest"]

# --- Logging ---------------------------------------------------------------------
CODE_MCP_LOG_DIR=logs
CODE_MCP_LOG_LEVEL=INFO
